# ==========================================
# 共用環境變數範本 (根目錄)
# ==========================================

# ----- Backend Settings -----
PORT=3001
# CORS allowlist (comma-separated origins). Leave empty for permissive local/dev.
# e.g. https://booking.example.org,https://console.example.org
ALLOWED_ORIGINS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password

# ----- Supabase Settings (Backend) -----
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----- Supabase Settings (Frontend Vite) -----
# Vite 規定前端使用的環境變數必須以 VITE_ 開頭
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ----- Tuya Smart Lock Settings -----
TUYA_CLIENT_ID=your_tuya_access_id
TUYA_CLIENT_SECRET=your_tuya_access_secret
TUYA_BASE_URL=https://openapi.tuyacn.com

